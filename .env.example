TELEGRAM_BOT_TOKEN=tu_token_de_telegram
TELEGRAM_USER_ID=tu_id_numerico
OLLAMA_MODEL=qwen3:1.7b
# Opcional: modelo independiente para interpretar búsquedas; por defecto OLLAMA_MODEL.
# SEARCH_MODEL=qwen3:1.7b
SEARCH_TIMEOUT_SECONDS=30
# local conserva los audios en tu equipo; groq los envía a Groq.
TRANSCRIPTION_PROVIDER=local
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
DIARY_TIMEZONE=Europe/Madrid
AUDIO_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=7
AUDIO_DIR=audios
DATABASE_PATH=dear_diary.db
BACKUP_DIR=backups
OLLAMA_TIMEOUT_SECONDS=120
MAX_AUDIO_BYTES=20000000
MAX_AUDIO_SECONDS=1800
MAX_LLM_CHARS=12000
LOG_LEVEL=INFO
